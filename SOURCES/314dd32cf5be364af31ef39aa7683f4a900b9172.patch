diff --git a/util.go b/util.go
index 423fdc7..1884107 100644
--- a/util.go
+++ b/util.go
@@ -4,13 +4,37 @@ import (
 	"bufio"
 	"fmt"
 	"os"
+	"path/filepath"
 	"strings"
 )
 
 // canonicalizeRepoName converts the string filename into a suitable filename.
 // It replaces all spaces with underscores and appends the given suffix.
-func canonicalizeRepoName(filename, suffix string) string {
-	return strings.TrimSuffix(strings.ReplaceAll(filename, " ", "_"), suffix) + suffix
+//
+// The returned name is always a single path component: filename must not
+// contain a path separator or a ".." element, must not be absolute, and must
+// not be empty. This prevents a caller from using the result to escape its
+// intended directory (path traversal). An error is returned if filename is not
+// a valid repository name.
+func canonicalizeRepoName(filename, suffix string) (string, error) {
+	// Validate the raw input before it is transformed: reject empty names,
+	// absolute paths, "." and ".." elements, and anything containing a path
+	// separator so the result cannot escape its intended directory.
+	if filename == "" || filename == "." || filename == ".." ||
+		filepath.IsAbs(filename) || strings.ContainsRune(filename, '/') ||
+		strings.ContainsRune(filename, filepath.Separator) {
+		return "", fmt.Errorf("invalid repository name: %q", filename)
+	}
+
+	name := strings.TrimSuffix(strings.ReplaceAll(filename, " ", "_"), suffix) + suffix
+
+	// Defense-in-depth: ensure the canonicalized name is still a single path
+	// component after transformation.
+	if filepath.Base(name) != name {
+		return "", fmt.Errorf("invalid repository name: %q", filename)
+	}
+
+	return name, nil
 }
 
 // readLines reads each line in file into a slice.
diff --git a/util_test.go b/util_test.go
new file mode 100644
index 0000000..25ca38b
--- /dev/null
+++ b/util_test.go
@@ -0,0 +1,42 @@
+package main
+
+import "testing"
+
+func TestCanonicalizeRepoName(t *testing.T) {
+	tests := []struct {
+		name    string
+		input   string
+		want    string
+		wantErr bool
+	}{
+		{name: "simple name", input: "epel", want: "epel.repo"},
+		{name: "name with spaces", input: "my repo", want: "my_repo.repo"},
+		{name: "existing suffix is not doubled", input: "foo.repo", want: "foo.repo"},
+		{name: "parent traversal", input: "../../etc/cron.d/foo", wantErr: true},
+		{name: "deep traversal", input: "../../../tmp/foo", wantErr: true},
+		{name: "absolute path", input: "/foo/bar", wantErr: true},
+		{name: "embedded separator", input: "foo/bar", wantErr: true},
+		{name: "absolute path with repo", input: "/etc/yum.repos.d/foo.repo", wantErr: true},
+		{name: "double dot", input: "..", wantErr: true},
+		{name: "single dot", input: ".", wantErr: true},
+		{name: "empty name", input: "", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := canonicalizeRepoName(tt.input, ".repo")
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("canonicalizeRepoName(%q) = %q, want error", tt.input, got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("canonicalizeRepoName(%q) unexpected error: %v", tt.input, err)
+			}
+			if got != tt.want {
+				t.Errorf("canonicalizeRepoName(%q) = %q, want %q", tt.input, got, tt.want)
+			}
+		})
+	}
+}
