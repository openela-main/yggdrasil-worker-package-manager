From 314dd32cf5be364af31ef39aa7683f4a900b9172 Mon Sep 17 00:00:00 2001
From: Jason Jerome <jajerome@redhat.com>
Date: Wed, 28 Oct 2026 13:44:02 -0400
Subject: [PATCH] fix: path traversal in repo file handling via unsanitized
 repo name

canonicalizeRepoName now rejects repository names that are not a single
safe path component (empty, ".", "..", absolute, or containing a path
separator), preventing AddRepo/RemoveRepo from writing or deleting files
outside /etc/yum.repos.d/.

CVE: CVE-2026-18379
Upstream Status: Embargoed
Resolves: RHEL-276911

Signed-off-by: Jason Jerome <jajerome@redhat.com>
---
 package_manager_dnf.go | 12 ++++++++++--
 package_manager_yum.go | 12 ++++++++++--
 util.go                | 28 ++++++++++++++++++++++++++--
 util_test.go           | 42 ++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 88 insertions(+), 6 deletions(-)
 create mode 100644 util_test.go

diff --git a/package_manager_dnf.go b/package_manager_dnf.go
index 0651426..fe90f5c 100644
--- a/package_manager_dnf.go
+++ b/package_manager_dnf.go
@@ -23,16 +23,24 @@ func (p *PackageManagerDnf) AddRepo(
 	name string,
 	content []byte,
 ) (stdout, stderr []byte, code int, err error) {
+	repoName, err := canonicalizeRepoName(name, ".repo")
+	if err != nil {
+		return nil, nil, -1, err
+	}
 	return nil, nil, -1, os.WriteFile(
-		filepath.Join("/etc/yum.repos.d/", canonicalizeRepoName(name, ".repo")),
+		filepath.Join("/etc/yum.repos.d/", repoName),
 		content,
 		0644,
 	)
 }
 
 func (p *PackageManagerDnf) RemoveRepo(name string) (stdout, stderr []byte, code int, err error) {
+	repoName, err := canonicalizeRepoName(name, ".repo")
+	if err != nil {
+		return nil, nil, -1, err
+	}
 	return nil, nil, -1, os.Remove(
-		filepath.Join("/etc/yum.repos.d/", canonicalizeRepoName(name, ".repo")),
+		filepath.Join("/etc/yum.repos.d/", repoName),
 	)
 }
 
